---
import { PROFILE } from "@site-config"
import Layout from "@/layouts/Layout.astro"
import EvidenciasGallery from "@/components/portfolio/EvidenciasGallery.astro"
import InvestigacionSection from "@/components/portfolio/InvestigacionSection.astro"
import Profile from "@/components/profile/Profile.astro"

import "@/styles/callout.css"
---

<Layout title="Home">
  <Profile profile={PROFILE} />

  <section class="seccion-perfil">
    <div class="contenedor-video">
      <h3>PRESENTACIÓN</h3>
      <video controls preload="metadata" class="video-reproductor">
        <source
          src={`${import.meta.env.BASE_URL}videos/entrevista.mp4`}
          type="video/mp4"
        />
        Tu navegador no soporta la reproducción de video.
      </video>
    </div>
  </section>

  <EvidenciasGallery />
  <InvestigacionSection />
</Layout>

<style>
  .seccion-perfil {
    max-inline-size: 50rem;
    margin-inline: auto;
    inline-size: 100%;
    text-align: center;
  }

  .contenedor-video {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--muted) 35%, var(--background));
  }

  .contenedor-video h3 {
    margin: 0;
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
  }

  .video-reproductor {
    inline-size: 100%;
    max-inline-size: 38rem;
    border-radius: var(--radius-lg);
    box-shadow: 0 0.5rem 1.25rem -0.5rem color-mix(in oklab, var(--ring) 30%, transparent);
  }
</style>
