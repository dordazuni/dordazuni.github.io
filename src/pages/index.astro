---
import { getCollection } from "astro:content"

import { PROFILE, SITE } from "@site-config"
import { PostManager } from "@/lib/blog"
import { loadSelectedPublications } from "@/lib/publications/loader"
import { getLatestUpdates } from "@/lib/updates"
import Layout from "@/layouts/Layout.astro"
import Button from "@/components/base/Button.astro"
import CardGroup from "@/components/base/card/CardGroup.astro"
import PreviewCard from "@/components/blog/PreviewCard.astro"
import Section from "@/components/layout/Section.astro"
import Profile from "@/components/profile/Profile.astro"
import PubCard from "@/components/publications/PubCard.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import UpdatesInline from "@/components/timeline/UpdatesInline.astro"

import {
  Content as MiscContent,
  rawContent as miscRaw,
} from "@/content/misc.md"
import {
  Content as ServicesContent,
  rawContent as servicesRaw,
} from "@/content/services.md"

import "@/styles/callout.css"

const hasServices = servicesRaw().trim().length > 0
const hasMisc = miscRaw().trim().length > 0

const {
  home: { careerHighlightCount, updateCount, publicationCount },
  blog: { featuredPostCount },
} = SITE

const careerHighlights =
  careerHighlightCount > 0 ? await getCollection("experience") : []
const cvHref =
  typeof PROFILE.links.cv === "object"
    ? PROFILE.links.cv?.href
    : PROFILE.links.cv
const renderedUpdates =
  updateCount > 0 ? await getLatestUpdates(updateCount) : []
const selectedPublications =
  publicationCount > 0
    ? (await loadSelectedPublications()).slice(0, publicationCount)
    : []

// Blog
const postManager = PostManager.getInstance()
const recentPosts =
  featuredPostCount > 0 ? await postManager.getMainPosts(featuredPostCount) : []
const recentPostsMetadata = await Promise.all(
  recentPosts.map((post) => postManager.getMetadata(post.id)),
)
---

<Layout title="Home">
  <Profile profile={PROFILE} />

  <section class="seccion-perfil">
    <div class="contenedor-video">
      <h3>PRESENTACIÓN</h3>
      <!--
        El video vive en public/videos/demo-pitzalab.mp4
        Usamos BASE_URL para que las rutas funcionen perfecto en GitHub Pages
      -->
      <video controls preload="metadata" class="video-reproductor">
        <source src={`${import.meta.env.BASE_URL}videos/entrevista.mp4`} type="video/mp4" />
        Tu navegador no soporta la reproducción de video.
      </video>
    </div>
  </section>

 <!--
  {careerHighlights.length > 0 && (
      <Section
        title="Career highlights"
        moreLink={cvHref}
        moreText="see CV →"
      >
        <ExperienceTimeline
          entries={careerHighlights}
          limit={careerHighlightCount}
          itemClass="home-experience-content"
        />
      </Section>
    )}

  {renderedUpdates.length > 0 && (
      <Section title="Latest updates" moreLink="/now">
        <UpdatesInline renderedUpdates={renderedUpdates} itemClass="home-update-content" />
      </Section>
    )}

  {selectedPublications.length > 0 && (
      <Section title="Selected publications" moreLink="/publications">
        <CardGroup class="selected-publications">
          {selectedPublications.map((pub) => (
            <PubCard pub={pub} filterableTags={false} />
          ))}
        </CardGroup>
      </Section>
    )}
  {recentPostsMetadata.length > 0 && (
      <Section title="Latest posts">
        <ul class="latest-posts-list">
          {recentPostsMetadata.map((metadata) => (
            <li>
              <PreviewCard metadata={metadata} />
            </li>
          ))}
        </ul>
        <div class="latest-posts-actions">
          <Button href="/blog" variant="default" class="home-arrow-button">
            See all posts <span aria-hidden="true">&rarr;</span>
          </Button>
          <Button href="/blog/tags" variant="ghost" class="home-arrow-button">
            Browse by tags <span aria-hidden="true">&rarr;</span>
          </Button>
        </div>
      </Section>
    )}

  {hasServices && (
      <Section title="Services">
        <prose-content>
          <ServicesContent />
        </prose-content>
      </Section>
    )}

  {hasMisc && (
      <Section title="Miscellaneous">
        <prose-content>
          <MiscContent />
        </prose-content>
      </Section>
    )}-->
</Layout>

<style>
  .selected-publications {
    gap: var(--space-s);
  }

  .latest-posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .latest-posts-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
  }

  :global(.home-arrow-button span[aria-hidden="true"]) {
    display: inline-block;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  :global(.home-arrow-button:hover span[aria-hidden="true"]) {
    transform: translateX(0.25rem);
  }

  :global(.home-experience-content) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.home-update-content) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;

    @media (width >= 48rem) {
      -webkit-line-clamp: 3;
    }
  }

  .seccion-perfil {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
    font-family: sans-serif;
  }

  .contenedor-avatar {
    margin-bottom: 2rem;
  }

  .avatar-img {
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #333;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }

  .contenedor-video {
    margin-top: 2rem;
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 12px;
  }

  .video-reproductor {
    width: 100%;
    max-width: 600px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }

</style>
