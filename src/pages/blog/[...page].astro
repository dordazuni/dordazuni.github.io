---
import type { PaginateFunction } from "astro"

import { SITE } from "@site-config"
import { PostManager } from "@/lib/blog"
import Layout from "@/layouts/Layout.astro"
import Pagination from "@/components/base/Pagination.astro"
import EvidenciasGallery from "@/components/portfolio/EvidenciasGallery.astro"
import InvestigacionSection from "@/components/portfolio/InvestigacionSection.astro"

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await PostManager.getInstance().getMainPosts()
  return paginate(allPosts, { pageSize: SITE.blog.postsPerPage })
}

const { page } = Astro.props
---

<Layout
  title="Evidencias e Investigación"
  breadcrumbs={[
    { label: "Blog", href: "/blog", icon: "blog" },
    { label: `Page ${page.currentPage}`, icon: "copy" },
  ]}
>
  <EvidenciasGallery />
  <InvestigacionSection />

  <Pagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl="/blog"
  />
</Layout>
