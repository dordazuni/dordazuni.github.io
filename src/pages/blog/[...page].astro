---
import type { PaginateFunction } from "astro"

import { SITE } from "@site-config"
import { PostManager } from "@/lib/blog"
import { getStageVariant, STAGES } from "@/lib/blog/stage"
import { getSortedTags } from "@/lib/blog/tag"
import { formatCount } from "@/lib/plural"
import Layout from "@/layouts/Layout.astro"
import Badge from "@/components/base/Badge.astro"
import Icon from "@/components/base/Icon.astro"
import Pagination from "@/components/base/Pagination.astro"
import TaxonomyChip from "@/components/base/TaxonomyChip.astro"
import PreviewCard from "@/components/blog/PreviewCard.astro"

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await PostManager.getInstance().getMainPosts()
  return paginate(allPosts, { pageSize: SITE.blog.postsPerPage })
}

const { page } = Astro.props
const postManager = PostManager.getInstance()

// Get posts grouped by year for current page
const currentPagePosts = page.data
const hasNoPosts = currentPagePosts.length === 0

let postsMetadata: Awaited<ReturnType<typeof postManager.getMetadata>>[] = []
let postsByYear: { year: number; posts: typeof postsMetadata }[] = []
let sortedTags: Awaited<ReturnType<typeof getSortedTags>> = []
let displayTags: typeof sortedTags = []
let numTags = 0
let moreTagsButton = false
let stageCounts: { name: string; count: number }[] = []

if (!hasNoPosts) {
  // Get metadata for all posts in parallel
  postsMetadata = await Promise.all(
    currentPagePosts.map((post) => postManager.getMetadata(post.id)),
  )

  // Group metadata by year
  const postsByYearMap = postsMetadata.reduce(
    (acc: Record<number, typeof postsMetadata>, metadata) => {
      const year = metadata.createdAt.getFullYear()
      ;(acc[year] ??= []).push(metadata)
      return acc
    },
    {},
  )

  postsByYear = Object.entries(postsByYearMap)
    .map(([year, posts]) => ({ year: parseInt(year), posts }))
    .sort((a, b) => b.year - a.year)

  sortedTags = await getSortedTags(() => postManager.getMainPosts())
  displayTags = sortedTags.slice(0, 15)
  numTags = sortedTags.length
  moreTagsButton = numTags > 15

  const allMainPosts = await postManager.getMainPosts()
  stageCounts = STAGES.map((s) => ({
    name: s.name,
    count: allMainPosts.filter((p) => p.data.stage === s.name).length,
  })).filter((s) => s.count > 0)
}

// Si ya importaste Image arriba, no necesitas repetirlo
import { Image } from 'astro:assets';

// Importa la imagen de tu evidencia desde la carpeta assets
import evidencia1 from '../assets/evidencia1.jpg';

---

<Layout
  title="Blog"
  breadcrumbs={[
    { label: "Blog", href: "/blog", icon: "blog" },
    { label: `Page ${page.currentPage}`, icon: "copy" },
  ]}
>
<section class="seccion-evidencias">
  <h3>Evidencias y Proyectos</h3>
  <p>Galería de trabajos y desarrollos recientes.</p>

  <div class="galeria">
    <!-- Tarjeta de la primera evidencia -->
    <article class="tarjeta-evidencia">
      <Image
        src={evidencia1}
        alt="Evidencia1"
        class="imagen-evidencia"
      />
      <div class="info-evidencia">
        <h4>Diagrama</h4>
      </div>
    </article>
  </div>
</section>

  <Pagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl="/blog"
  />
</Layout>

<style>
  .blog-filters,
  filter-group,
  blog-index,
  .post-year,
  .post-year ul {
    display: flex;
    flex-direction: column;
  }

  .blog-filters {
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  filter-group {
    gap: var(--space-2xs);
  }

  .blog-filters h2 {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
  }

  filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .count {
    margin-inline-start: 0.25rem;
    opacity: 0.7;
  }

  blog-index {
    min-block-size: calc(100dvh - 18rem);
    gap: var(--space-xl);
  }

  .empty-state {
    display: flex;
    min-block-size: 14rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    text-align: center;
  }

  .empty-state h2 {
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
  }

  .empty-state p,
  .post-count {
    color: var(--muted-foreground);
  }

  .post-count {
    font-size: var(--step--1);
  }

  .post-year {
    gap: var(--space-s);
  }

  .post-year h2 {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
  }

  .post-year ul {
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }


    .seccion-evidencias {
      max-width: 900px;
      margin: 4rem auto;
      padding: 0 2rem;
      text-align: center;
      font-family: sans-serif;
    }

    .seccion-evidencias h3 {
      color: #222;
      margin-bottom: 0.5rem;
    }

    /* Usamos CSS Grid. Ahora mismo se verá centrada, pero cuando agregues
       más tarjetas, se organizarán solas en varias columnas */
    .galeria {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-top: 2rem;
      max-width: 500px; /* Ancho máximo para una sola tarjeta */
      margin-inline: auto; /* Centra la tarjeta actual */
    }

    /* Cuando agregues más de una tarjeta y la pantalla sea grande, se adaptarán */
    @media (min-width: 768px) {
      .galeria {
        max-width: 100%;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      }
    }

    .tarjeta-evidencia {
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 1px solid #eaeaea;
      display: flex;
      flex-direction: column;
    }

    .tarjeta-evidencia:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .imagen-evidencia {
      width: 100%;
      height: 250px;
      object-fit: cover; /* Asegura que la imagen no se deforme */
      display: block;
    }

    .info-evidencia {
      padding: 1.5rem;
      text-align: left;
    }

    .info-evidencia h4 {
      margin: 0 0 0.5rem 0;
      color: #333;
      font-size: 1.2rem;
    }

    .info-evidencia p {
      margin: 0;
      color: #666;
      font-size: 0.95rem;
      line-height: 1.5;
    }
</style>
